# Dependencies
node_modules/
jspm_packages/

# @brave/core's own .d.ts tree — regenerated by the Brave Editor on every core rebuild, never
# meant to be committed as source
brave/

# Build and output
dist/
out/
build/
*.tsbuildinfo

# Compressed texture sidecars — regenerated at import/settings-change time, never committed
*.ktx2

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Arquivos temporários do Sistema Operacional
.DS_Store
Thumbs.db

# Animation clips downloaded from Mixamo for the developer's own use: kept on the developer's machine, never committed (Adobe's terms do not allow redistributing them).
mixamo/

# Scratch of the kit's own tools
tmp/
